rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isMember(chat) { return authed() && request.auth.uid in chat.data.members; }

    // Профили пользователей: читают все вошедшие, пишет только владелец
    match /users/{uid} {
      allow read: if authed();
      allow create, update, delete: if authed() && request.auth.uid == uid;
      // Приватные настройки (чёрный список и т.п.) — видит и меняет только владелец
      match /private/{docId} {
        allow read, write: if authed() && request.auth.uid == uid;
      }
    }

    // Реестр уникальных @username. Чтение открыто (нужно на экране входа,
    // чтобы найти email по username); email-ы синтетические, секретов нет.
    match /usernames/{name} {
      allow get: if true;
      allow list: if authed();
      allow create: if authed() && request.resource.data.uid == request.auth.uid;
      allow delete: if authed() && resource.data.uid == request.auth.uid;
    }

    // Версия приложения для уведомления об обновлении (пишет только админ через сервисный ключ)
    match /meta/app {
      allow get: if true;
    }

    // Карточки инвайтов: только точечное чтение по коду, перебор запрещён
    match /invites/{code} {
      allow get: if authed();
      allow list: if false;
      allow create, update, delete: if authed()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
    }

    match /chats/{chatId} {
      // get разрешён и для несуществующих документов (resource == null):
      // клиент проверяет наличие диалога перед созданием — иначе get падает с permission-denied
      allow get: if authed() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if isMember(resource);
      allow create: if authed() && request.auth.uid in request.resource.data.members;
      // Обновлять могут участники; не-участник может только добавить СЕБЯ
      // (вступление по инвайт-ссылке — id чата он узнаёт из карточки инвайта)
      allow update: if isMember(resource)
        || (authed()
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      allow delete: if authed()
        && (resource.data.ownerUid == request.auth.uid
            || (resource.data.type != 'group' && request.auth.uid in resource.data.members));

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)); }
        function chatData() { return chat().data; }
        function amChatAdmin() {
          return chatData().ownerUid == request.auth.uid
            || request.auth.uid in chatData().get('admins', []);
        }
        // В ЛС нельзя писать тому, кто вас заблокировал
        function blockedByRecipient() {
          let m = chatData().members;
          let rec = m[0] == request.auth.uid ? m[1] : m[0];
          return exists(/databases/$(database)/documents/users/$(rec)/private/prefs)
            && request.auth.uid in get(/databases/$(database)/documents/users/$(rec)/private/prefs).data.get('blocked', []);
        }
        allow read: if authed() && request.auth.uid in chatData().members;
        allow create: if authed()
          && request.auth.uid in chatData().members
          && request.resource.data.sender == request.auth.uid
          && (chatData().type != 'channel' || amChatAdmin())
          && (chatData().type != 'private' || !blockedByRecipient());
        // Правка/реакции/голоса/удаление: автор, либо админ, либо участник меняет только reactions/poll
        allow update, delete: if authed()
          && request.auth.uid in chatData().members
          && (resource.data.sender == request.auth.uid
              || amChatAdmin()
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll']));
      }
    }
  }
}
